<!DOCTYPE html>
<html lang="mn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Chat</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

<div class="container">
    <h1>🤖 AI Assistant</h1>

    <div class="chat-box" id="chatBox">
        <div class="message ai">
            Сайн байна уу! Би AI туслах байна.
        </div>
    </div>

    <div class="input-area">
        <input 
        type="text" 
        id="userInput" 
        placeholder="Мессеж бичнэ үү...">

        <button onclick="sendMessage()">
            Илгээх
        </button>
    </div>
</div>

<script src="script.js"></script>

</body>
</html>
* {
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    margin: 0;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #0f172a;
}

.container {
    width: 95%;
    max-width: 450px;
    height: 650px;
    background: #1e293b;
    border-radius: 20px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 0 30px rgba(0,0,0,0.4);
}

h1 {
    color: white;
    text-align: center;
}

.chat-box {
    flex: 1;
    overflow-y: auto;
    padding: 10px;
    margin-bottom: 15px;
}

.message {
    padding: 12px;
    margin: 8px 0;
    border-radius: 12px;
    max-width: 80%;
}

.ai {
    background: #334155;
    color: white;
    align-self: flex-start;
}

.user {
    background: #2563eb;
    color: white;
    align-self: flex-end;
    margin-left: auto;
}

.input-area {
    display: flex;
    gap: 10px;
}

input {
    flex: 1;
    padding: 12px;
    border-radius: 10px;
    border: none;
    outline: none;
}

button {
    padding: 12px 18px;
    border: none;
    border-radius: 10px;
    background: #3b82f6;
    color: white;
    cursor: pointer;
}

button:hover {
    background: #2563eb;
}
function sendMessage() {

    let input = document.getElementById("userInput");
    let chatBox = document.getElementById("chatBox");

    let text = input.value.trim();

    if (text === "") {
        return;
    }

    // User message
    let userMsg = document.createElement("div");
    userMsg.className = "message user";
    userMsg.innerText = text;
    chatBox.appendChild(userMsg);

    input.value = "";

    // AI reply (demo)
    setTimeout(() => {

        let aiMsg = document.createElement("div");
        aiMsg.className = "message ai";

        let reply = "Би таны мессежийг ойлголоо: " + text;

        aiMsg.innerText = reply;
        chatBox.appendChild(aiMsg);

        chatBox.scrollTop = chatBox.scrollHeight;

    }, 500);
}
